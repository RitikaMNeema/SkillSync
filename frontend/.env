# Dev: browser calls /api → Vite proxies here (see vite.config.ts)
VITE_API_BASE_URL=/api

# Dev: send all /api/* to the FastAPI gateway (fixes flaky multipart / EPIPE vs per-port proxy).
# Requires: backend gateway running on port 3000 — e.g. from backend/: uvicorn main:app --host 127.0.0.1 --port 3000
VITE_PROXY_GATEWAY=http://127.0.0.1:3000
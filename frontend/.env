# Dev: browser calls /api → Vite proxies here (see vite.config.ts)
VITE_API_BASE_URL=/api

# Dev: send all /api/* to the FastAPI gateway (multipart uploads). Uncomment only when the gateway is running:
#   cd backend && export PYTHONPATH="$PWD" && uvicorn main:app --host 127.0.0.1 --port 3000
# If this is set but port 3000 is down, login and every API call will fail with a generic 5xx message.
# VITE_PROXY_GATEWAY=http://127.0.0.1:3000
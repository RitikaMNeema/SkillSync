VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=ws://localhost:3007

# ── Proxy mode (pick ONE approach) ─────────────────────────────────────────────
#
# A) Microservices — default `npm run dev` (vite.config.ts): each /api/* path goes to
#    localhost:3001 auth, 3002 profile … NO gateway required. Requires:
#    `cd backend && docker compose up -d`
#    Verify: curl -s http://localhost:3001/health | head
#
# B) Unified gateway — set this and keep uvicorn gateway running on port 3000:
#    cd backend && PYTHONPATH=. uvicorn main:app --host 127.0.0.1 --port 3000
# VITE_PROXY_GATEWAY=http://127.0.0.1:3000
#
# If VITE_PROXY_GATEWAY is SET but nothing runs on :3000, login returns HTTP 502.

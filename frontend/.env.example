VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=ws://localhost:3007

# ── Proxy mode (pick ONE approach) ─────────────────────────────────────────────
#
# A) Microservices — default `npm run dev` (vite.config.ts): each /api/* path goes to
#    localhost:3001 auth, 3002 profile … NO gateway required. Requires:
#    `cd backend && docker compose up -d`
#    Verify: curl -s http://localhost:3001/health | head
#
# B) Unified gateway — set this and keep uvicorn gateway running on port 3000:
#    cd backend && PYTHONPATH=. uvicorn main:app --host 127.0.0.1 --port 3000
# VITE_PROXY_GATEWAY=http://127.0.0.1:3000
#
# If VITE_PROXY_GATEWAY is SET but nothing runs on :3000, login returns HTTP 502.

# ── AI service (agentic matching / outreach) ────────────────────────────────────
# Dev default: same-origin `window.location.origin + "/ai-service"` (see api/ai.ts).
# Vite proxies `/ai-service` → ai-service on port 3010 (vite.config.ts).
# Override only if needed:
# VITE_AI_API_BASE_URL=http://localhost:3010
# VITE_AI_WS_BASE_URL=ws://localhost:3010
#
# Docker (frontend-dev): use docker compose, not `npm run dev` on the host, unless you prefer host dev.
# From inside the Vite container, "localhost" is the container — use VITE_PROXY_HOST=host.docker.internal
# and ensure backend maps ports to the host. Optional explicit AI proxy: VITE_AI_PROXY_TARGET=http://host.docker.internal:3010
# The production nginx image proxies /ai-service to API_HOST:3010; rebuild the image after changing nginx.

server {
  listen 80;
  server_name _;
  client_max_body_size 20m;

  root /usr/share/nginx/html;
  index index.html;

  # Legacy app URL (/recruiters/:id showed a minimal stub). Redirect to full SPA profile.
  # Include `$http_host` so :8080 and other forwarded ports survive the Location header.
  location ~ ^/recruiters/(\d+)/?$ {
    return 302 $scheme://$http_host/profile/$1?type=recruiter;
  }

  # SPA fallback (React Router)
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Proxy API calls to the backend services running on the Docker host.
  # Works well with: `cd backend && docker compose up -d`
  #
  # You can override the host via env:
  # - API_HOST=host.docker.internal (default; Docker Desktop Mac/Windows)
  # - API_HOST=host-gateway (Linux with extra_hosts mapping)
  #
  # NOTE: These ports match the backend service ports in the repo docs.
  resolver 127.0.0.11 valid=30s;
  set $api_host ${API_HOST};

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_connect_timeout 120s;
  proxy_send_timeout 120s;
  proxy_read_timeout 120s;

  location ^~ /api/auth/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3001;
  }
  location ^~ /api/members/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3002;
  }
  location ^~ /api/posts/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3002;
  }
  location ^~ /api/recruiters/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3003;
  }
  location ^~ /api/connections/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3004;
  }
  location ^~ /api/jobs/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3005;
  }
  location ^~ /api/applications/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3006;
  }
  location ^~ /api/threads/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3007;
  }
  location ^~ /api/messages/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3007;
  }
  location ^~ /api/analytics/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3008;
  }
  location ^~ /api/network/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3009;
  }
  location ^~ /api/events/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_host:3008;
  }

  # WebSocket (AI service) — must be before the generic /ai-service/ block.
  location ^~ /ai-service/ai/ws/ {
    rewrite ^/ai-service/(.*)$ /$1 break;
    proxy_pass http://$api_host:3010;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  # Agentic AI (FastAPI on host port 3010). SPA uses baseURL `/ai-service` (see api/ai.ts).
  location ^~ /ai-service/ {
    rewrite ^/ai-service/(.*)$ /$1 break;
    proxy_pass http://$api_host:3010;
  }
}

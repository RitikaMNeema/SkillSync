# Copy to `.env` in this directory and set real secrets. Used by `docker compose` from `backend/`.
# Example: cp .env.example .env
#
# --- Running `uvicorn` on your Mac while MySQL/Mongo/Redis run via `docker compose up` ---
# Use 127.0.0.1 and the *published* ports from docker-compose.yml (mysql 3307, mongo 27018, redis 6380).
# Optional: put only these overrides in `.env.local` (loaded after `.env`).
#
# --- Running app containers inside Docker Compose ---
# Compose injects MYSQL_HOST=mysql, MONGO_URI with @mongo, REDIS_HOST=redis (see x-docker-runtime-env).

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=linkedin_db

# MongoDB root (required for docker-compose.yml mongo + mongo-init + healthcheck)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# MongoDB — host + port when running uvicorn on your machine (compose publishes 27018)
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
# Optional: set MONGO_URI yourself. If unset, the app builds one from MONGO_INITDB_* (password is
# URL-encoded, so values like SkillSync1! work). If you *do* set MONGO_URI, it must match the user
# stored in the mongo_data volume; changing only MONGO_INITDB_ROOT_PASSWORD in .env does not
# re-key an existing volume — use the old password in the URI, or `docker compose down -v` (wipes DBs).
# MONGO_URI=mongodb://admin:changeme@127.0.0.1:27018/linkedin_db?authSource=admin

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Kafka
KAFKA_BROKERS=kafka:9092

# JWT
JWT_SECRET=changeme-in-development
JWT_EXPIRE_MINUTES=10080

# Microservice ports (docker-compose host + container mapping)
AUTH_SERVICE_PORT=3001
PROFILE_SERVICE_PORT=3002
RECRUITER_SERVICE_PORT=3003
CONNECTION_SERVICE_PORT=3004
JOB_SERVICE_PORT=3005
APPLICATION_SERVICE_PORT=3006
MESSAGING_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008

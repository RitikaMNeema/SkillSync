# SkillSync backend environment
#
# --- Recommended Docker workflow (avoids Mongo/MySQL “wrong password” after branch pulls) ---
# 1. make bootstrap       # copies this file → .env.local once (backend/.env.local is gitignored)
# 2. Edit .env.local passwords only once; keep them stable for your Docker volumes.
# 3. make up              # or: docker compose --env-file .env.example --env-file .env.local up -d
#
# --- Running `uvicorn` on your Mac while MySQL/Mongo/Redis run via `docker compose` ---
# Use 127.0.0.1 and the published ports below (mysql 3310 in compose.yml, mongo 27018, redis 6380).
#
# --- Running app containers inside Docker Compose ---
# Compose injects MYSQL_HOST=mysql, MONGO_URI=mongodb://mongo:27017/linkedin_db, REDIS_HOST=redis (see docker-compose.yml x-docker-runtime-env).

# MySQL (Docker Compose mysql service expects MYSQL_USER ≠ root for the created app account)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_USER=linkedin_user
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PASSWORD=changeme_app
MYSQL_DATABASE=linkedin_db

# Compose `mongo` service runs without auth (see docker-compose.yml). For host `uvicorn`, use a credential-free URI.
MONGO_URI=mongodb://127.0.0.1:27018/linkedin_db
# Optional: only if you enable Mongo root auth (remove blank overrides from mongo service in compose).
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=changeme_mongo

MONGO_HOST=127.0.0.1
MONGO_PORT=27018

# Redis (compose publishes 6380 → 6379 in container)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Kafka
KAFKA_BROKERS=kafka:9092

# JWT
JWT_SECRET=changeme-in-development
JWT_EXPIRE_MINUTES=10080

# Microservice ports
AUTH_SERVICE_PORT=3001
PROFILE_SERVICE_PORT=3002
RECRUITER_SERVICE_PORT=3003
CONNECTION_SERVICE_PORT=3004
JOB_SERVICE_PORT=3005
APPLICATION_SERVICE_PORT=3006
MESSAGING_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008
AI_SERVICE_PORT=3010

# AI service → host Ollama (from inside Docker Desktop use host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

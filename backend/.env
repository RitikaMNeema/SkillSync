# Database
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=linkedin_db
# Services connect as root (local dev). Must match MYSQL_ROOT_PASSWORD.
MYSQL_USER=root
MYSQL_PASSWORD=seekrit03
MYSQL_ROOT_PASSWORD=seekrit03

MONGO_URI=mongodb://host.docker.internal:27017/linkedin_db

REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:9092

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE_MINUTES=10080

# Service Ports
AUTH_SERVICE_PORT=3001
PROFILE_SERVICE_PORT=3002
RECRUITER_SERVICE_PORT=3003
CONNECTION_SERVICE_PORT=3004
JOB_SERVICE_PORT=3005
APPLICATION_SERVICE_PORT=3006
MESSAGING_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008

# Node
NODE_ENV=development



# Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_DATABASE=linkedin_db
MYSQL_USER=linkedin_user
MYSQL_PASSWORD=changeme_app
MYSQL_ROOT_PASSWORD=changeme_root

MONGO_URI=mongodb://admin:changeme_mongo@127.0.0.1:27018/linkedin_db?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo

REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:9092

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE_MINUTES=10080

# Service Ports
AUTH_SERVICE_PORT=3001
PROFILE_SERVICE_PORT=3002
RECRUITER_SERVICE_PORT=3003
CONNECTION_SERVICE_PORT=3004
JOB_SERVICE_PORT=3005
APPLICATION_SERVICE_PORT=3006
MESSAGING_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008
AI_SERVICE_PORT=3010
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Node
NODE_ENV=development
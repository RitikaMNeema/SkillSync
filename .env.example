# ──────────────────────────────────────────────────────────────
# SkillSync — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed to the repo.
# Share actual secrets with teammates via a password manager
# or your team's agreed channel (Slack DM, 1Password, etc.)
# ──────────────────────────────────────────────────────────────

# ── MySQL ──────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=linkedin_db
MYSQL_USER=linkedin_user
MYSQL_PASSWORD=linkedin_pass
MYSQL_ROOT_PASSWORD=rootpassword

# ── MongoDB ────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/linkedin_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ──────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ── JWT ────────────────────────────────────────────────────────
# Change this to any long random string in production
JWT_SECRET=your-secret-key-here
JWT_EXPIRE_MINUTES=10080

# ── Service Ports ──────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
PROFILE_SERVICE_PORT=3002
RECRUITER_SERVICE_PORT=3003
CONNECTION_SERVICE_PORT=3004
JOB_SERVICE_PORT=3005
APPLICATION_SERVICE_PORT=3006
MESSAGING_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008

# ── Environment ────────────────────────────────────────────────
NODE_ENV=development
